# Copie este arquivo para ".env" e preencha com os valores reais antes de publicar.
# Nenhuma dessas variáveis deve conter chaves/segredos privados — todas são
# consumidas no front-end (client-side), então mantenha aqui apenas URLs e IDs públicos.

# Endpoint que recebe o POST com os dados do lead (n8n, Make, CRM, webhook.site, etc.)
VITE_WEBHOOK_URL=

# Link de agendamento (Cal.com, Calendly...) usado no embed/CTA de "Agendar diagnóstico"
VITE_CALENDAR_URL=

# Redes sociais e contato — abrem em nova aba
VITE_INSTAGRAM_URL=https://instagram.com/
VITE_LINKEDIN_URL=https://linkedin.com/in/
VITE_WHATSAPP_URL=https://wa.me/55SEUNUMERO

# Analytics (opcionais — deixe em branco para não injetar o script)
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
